{
  "permissions": {
    "allow": [
      "Read(./**)",
      "Glob",
      "Grep",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(wc:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git submodule update:*)"
    ],
    "deny": [
      "Edit(./namaerp-docs/**)",
      "Write(./namaerp-docs/**)",
      "Edit(./namaerp-dm/**)",
      "Write(./namaerp-dm/**)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "powershell -NoProfile -ExecutionPolicy Bypass -Command '$d = $env:CLAUDE_PROJECT_DIR; if (-not $d) { $d = $PWD }; & (Join-Path $d .claude/hooks/statusline.ps1)'"
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -Command '$d = $env:CLAUDE_PROJECT_DIR; if (-not $d) { $d = $PWD }; & (Join-Path $d .claude/hooks/context-guard.ps1)'",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
